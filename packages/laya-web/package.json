{
  "name": "@wexare/laya-web",
  "version": "0.1.0",
  "description": "Run Laya, the open-source System 1 typed-decision model, entirely in the browser via ONNX Runtime Web",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "LICENSE-THIRD-PARTY"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "LAYA_E2E=1 vitest run",
    "prepack": "cp ../../LICENSE ../../LICENSE-THIRD-PARTY ."
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  }
}
